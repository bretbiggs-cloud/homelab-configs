# ==============================================================================
# VPN-Bridge Per-Stack Environment Secrets (vpn-bridge/.env.example)
#
# Connects to Private Internet Access (PIA) using your account credentials
# and registers a dedicated Tailscale exit node ('vpn-bridge') on your Tailnet.
# Global variables from root .env are synced automatically by 'homelab.sh setup'.
# ==============================================================================

# Private Internet Access (PIA) Credentials
VPN_USER=
VPN_PASS=

# PIA US Egress Region Cluster (defaults to low-latency US servers)
PIA_REGION=us_east,us_chicago,us_nyc

# Tailscale Pre-Authentication Key (e.g., tskey-auth-..., optional after initial registration)
TS_AUTHKEY=
