# Synology: active per-stack templates are authoritative; remaining Dockge/macvlan/Restic values are upstream references, not deployed services.
# ==============================================================================
# Global Homelab Environment Variables (.env.example)
#
# Purpose:
#   Defines host-wide directory paths, non-root user/group IDs, timezone, and
#   macvlan network parameters shared across all Docker Compose stacks.
#
# Operation:
#   When 'sudo ./homelab.sh setup' runs, it initializes the root '.env' from
#   this template (resolving ${USER} to the active non-root username) and
#   automatically propagates these variables into every '<stack>/.env' and
#   '${DOCKGE_DIR}/.env' so stacks work both standalone and via the Dockge UI.
# ==============================================================================

# Root directory for persistent container state and configuration volumes
DOCKER_DATA_DIR=/volume1/docker/homelab-v2

# Shared media library directory (mounted read-write by downloaders/managers, read-only by Jellyfin)
MEDIA_DIR=/volume1/media

# Host directory where Dockge's own compose.yml resides (one level above stacks/)
DOCKGE_DIR=/opt/${USER}/dockge

# Host directory where git-tracked stack subdirectories reside (must match inside/outside Dockge container)
DOCKGE_STACKS_DIR=/opt/${USER}/dockge/stacks

# Non-root user and group IDs for application containers (1026:100 on this Synology deployment)
PUID=1026
PGID=100

# System timezone passed to containers for log timestamps and scheduled tasks
TZ=America/New_York

# Docker macvlan network ('external_npm') parameters attaching Nginx Proxy Manager to the physical LAN
EXTERNAL_NPM_SUBNET=192.168.0.0/24
EXTERNAL_NPM_GATEWAY=192.168.0.1
EXTERNAL_NPM_PARENT=eth0
NPM_IPV4_ADDRESS=192.168.0.4
TAILSCALE_IPV4_ADDRESS=192.168.0.5

# Restic backup repository path on primary storage and retention duration (days)
BACKUP_RESTIC_REPO=/volume1/backups/homelab-docker
BACKUP_RETENTION_DAYS=30
